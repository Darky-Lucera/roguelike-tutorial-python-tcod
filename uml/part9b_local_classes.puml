@startuml part9b_local_classes

!theme mimeograph

top to bottom direction

hide members
hide circle

skinparam roundcorner 10
skinparam classBackgroundColor #ece9e8
skinparam noteFontSize 10
skinparam noteBorderThickness 1
skinparam noteMargin 2
skinparam notePadding 2
skinparam nodesep 20
skinparam ranksep 35

set namespaceSeparator none

'--------------------------------------
' Classes
'--------------------------------------

class "TargetingAction" as game.actions.TargetingAction {
}

class "SingleRangedTargetingAction" as game.actions.SingleRangedTargetingAction {
}

class "AreaRangedTargetingAction" as game.actions.AreaRangedTargetingAction #ccc9e8 {
}

class "GameState" as game.game_states.GameState #cce9c7 {
}

class "SelectIndexState" as game.game_states.SelectIndexState {
}

class "AreaRangedAttackState" as game.game_states.AreaRangedAttackState #ccc9e8 {
}

class "GameMap" as game.map.game_map.GameMap #cce9c7 {
}

class "Consumable" as game.entities.components.consumable.Consumable {
}

class "FireballDamageConsumable" as game.entities.components.consumable.FireballDamageConsumable #ccc9e8 {
}

class "MappingConsumable" as game.entities.components.consumable.MappingConsumable <<Ex. 9.1>> #ecdac7 {
}

class "DrainConsumable" as game.entities.components.consumable.DrainConsumable <<Ex. 9.2>> #ecdac7 {
}

class "TeleportConsumable" as game.entities.components.consumable.TeleportConsumable <<Ex. 9.3>> #ecdac7 {
}

'--------------------------------------
' Relations
'--------------------------------------

' Inheritance: base class first, derived class second.
game.actions.TargetingAction <|-- game.actions.SingleRangedTargetingAction
game.actions.TargetingAction <|-- game.actions.AreaRangedTargetingAction

game.game_states.SelectIndexState <|-- game.game_states.AreaRangedAttackState

game.entities.components.consumable.Consumable <|-- game.entities.components.consumable.FireballDamageConsumable
game.entities.components.consumable.Consumable <|-- game.entities.components.consumable.MappingConsumable
game.entities.components.consumable.Consumable <|-- game.entities.components.consumable.DrainConsumable
game.entities.components.consumable.Consumable <|-- game.entities.components.consumable.TeleportConsumable

' Same path as Part 9a: the consumable returns data, GameState installs the cursor.
game.entities.components.consumable.FireballDamageConsumable --> game.actions.AreaRangedTargetingAction : get_action() returns
game.game_states.GameState --> game.game_states.AreaRangedAttackState : installs
game.game_states.AreaRangedAttackState --> game.actions.AreaRangedTargetingAction : callback

' Preview and damage read the same weights.
' The longer arrows push GameMap one row below the targeting actions, so its
' arrows do not merge with the get_action() ones.
game.game_states.AreaRangedAttackState ---> game.map.game_map.GameMap : get_aoe_weights_in_radius()
game.entities.components.consumable.FireballDamageConsumable ---> game.map.game_map.GameMap : get_aoe_weights_in_radius()

' Exercise consumables reuse the Part 9a single-target path.
game.entities.components.consumable.DrainConsumable --> game.actions.SingleRangedTargetingAction : get_action() returns
game.entities.components.consumable.TeleportConsumable --> game.actions.SingleRangedTargetingAction : get_action() returns
game.entities.components.consumable.MappingConsumable ---> game.map.game_map.GameMap : reveals mapped_tiles

'--------------------------------------
' Layout hints
'--------------------------------------

game.game_states.GameState -[hidden]down- game.game_states.SelectIndexState
game.game_states.SelectIndexState -[hidden]down- game.game_states.AreaRangedAttackState

game.actions.TargetingAction -[hidden]down- game.actions.SingleRangedTargetingAction
game.actions.SingleRangedTargetingAction -[hidden]right- game.actions.AreaRangedTargetingAction

game.entities.components.consumable.Consumable -[hidden]down- game.entities.components.consumable.FireballDamageConsumable
game.entities.components.consumable.FireballDamageConsumable -[hidden]right- game.entities.components.consumable.MappingConsumable
game.entities.components.consumable.MappingConsumable -[hidden]right- game.entities.components.consumable.DrainConsumable
game.entities.components.consumable.DrainConsumable -[hidden]right- game.entities.components.consumable.TeleportConsumable

legend top right
<size:11><back:#ece9e8>   </back> Unchanged - <back:#ccc9e8>   </back> New - <back:#cce9c7>   </back> Modified - <back:#ecdac7>   </back> Exercise</size>
endlegend

@enduml
